# Copy this file to .env and fill in the values from your Supabase dashboard:
# Settings -> API.
#
# .env is gitignored. Do not commit real values -- this repo is public.
#
# Use the ANON / PUBLISHABLE key. Never the service_role (sb_secret_) key:
# it bypasses row-level security, and the build will refuse it anyway.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
