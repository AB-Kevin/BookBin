# Copy this file to .env and fill in the values from your Supabase dashboard:
# Settings -> API.
#
# .env is gitignored. Do not commit real values -- this repo is public.
#
# Use the PUBLISHABLE key (sb_publishable_...), or the legacy anon key if that
# is what your project shows -- Supabase is still migrating between the two,
# and either works here. Both are safe in a client: row-level security is what
# protects the data, not the secrecy of this key.
#
# NEVER the secret key (sb_secret_...) or the legacy service_role key. Those
# bypass row-level security entirely, and the build will refuse them anyway.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
