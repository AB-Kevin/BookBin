{
  "name": "bookbin",
  "version": "0.1.3",
  "description": "Inventory tracker and invoice generator",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "release": "electron-builder --win --publish always",
    "release:mac": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bookbin.app",
    "productName": "BookBin",
    "files": [
      "main.js",
      "preload.js",
      "workspace.js",
      "db/**/*",
      "ipc/**/*",
      "renderer/**/*",
      "build/BookBin-512.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/BookBin-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/BookBin-512.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "BookBin",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "electron@44.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
