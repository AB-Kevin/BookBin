{
  "name": "bookbin",
  "version": "2.1.1",
  "description": "Inventory tracker and invoice generator",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/write-supabase-config.js && electron-builder --win",
    "dist:mac": "node scripts/write-supabase-config.js && electron-builder --mac",
    "release": "node scripts/write-supabase-config.js && electron-builder --win --publish always",
    "release:mac": "node scripts/write-supabase-config.js && electron-builder --mac --publish always",
    "config": "node scripts/write-supabase-config.js",
    "android": "node scripts/build-android.js",
    "android:debug": "node scripts/build-android.js --debug",
    "android:run": "node scripts/build-android.js --run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "buffer": "^6.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "path-browserify": "^1.0.1"
  },
  "build": {
    "appId": "com.bookbin.app",
    "productName": "BookBin",
    "files": [
      "main.js",
      "preload.js",
      "config/**/*",
      "db/**/*",
      "ipc/**/*",
      "renderer/**/*",
      "supabase/migrations/**/*",
      "supabase/functions/**/*",
      "build/BookBin-512.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/BookBin-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/BookBin-512.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "BookBin",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
